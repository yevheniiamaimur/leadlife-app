  },
  "field02Subtitle": "Initiative",
  "@field02Subtitle": {
    "description": "Field 2 (Connection) — subtitle text"
  },
  "field02Intro": "Every idea starts as a spark.\n\nGrowth begins when you share it with the world.\nEvery desire has an origin.\nRemember where this dream first appeared in your life.",
  "@field02Intro": {
    "description": "Field 2 (Connection) — intro text"
