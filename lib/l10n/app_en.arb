  "legalPrivacySection1Heading": "Overview",
  "@legalPrivacySection1Heading": {"description": "Privacy Policy section heading"},
  "legalPrivacySection1Body": "Last updated: [fill in before release]. This policy explains what information LeadLife (\"we\") collects when you use the LeadLife app, why we collect it, and the choices you have. By using the app you agree to this policy.",
  "@legalPrivacySection1Body": {"description": "Privacy Policy section body"},

  "legalPrivacySection2Heading": "Information We Collect",
  "@legalPrivacySection2Heading": {"description": "Privacy Policy section heading"},
  "legalPrivacySection2Body": "Profile details you enter (your name, birthday, email address, and areas of focus) so we can personalize your journey. Account credentials, only if you choose to create an account with Google, Apple, or email and password, handled through Firebase Authentication. Usage and diagnostic data, such as anonymized interaction events and crash reports, your device model, operating system, and app version, collected through Firebase Analytics and Crashlytics. Purchase information, if you subscribe, processed by the App Store or Google Play and our subscription billing partner — we never see or store your card details.",
  "@legalPrivacySection2Body": {"description": "Privacy Policy section body"},

  "legalPrivacySection3Heading": "How We Use Your Information",
  "@legalPrivacySection3Heading": {"description": "Privacy Policy section heading"},
  "legalPrivacySection3Body": "To personalize your journey and reminders, to send the gentle reminder notifications you opted into, to diagnose crashes and fix bugs, to understand how features are used so we can improve the app, and to manage your account and subscription.",
  "@legalPrivacySection3Body": {"description": "Privacy Policy section body"},

  "legalPrivacySection4Heading": "Where Your Data Lives",
  "@legalPrivacySection4Heading": {"description": "Privacy Policy section heading"},
  "legalPrivacySection4Body": "Your profile details stay only on your device (in local app storage) unless you choose to create an account. If you create an account, your credentials are stored by Firebase Authentication (Google LLC). Analytics and crash data are processed by Firebase Analytics and Firebase Crashlytics (Google LLC).",
  "@legalPrivacySection4Body": {"description": "Privacy Policy section body"},

  "legalPrivacySection5Heading": "Sharing",
  "@legalPrivacySection5Heading": {"description": "Privacy Policy section heading"},
  "legalPrivacySection5Body": "We do not sell your data and we do not use advertising networks. We only share data with service providers who act on our behalf: Firebase/Google, the App Store or Google Play, and our subscription billing partner.",
  "@legalPrivacySection5Body": {"description": "Privacy Policy section body"},

  "legalPrivacySection6Heading": "International Transfers",
  "@legalPrivacySection6Heading": {"description": "Privacy Policy section heading"},
  "legalPrivacySection6Body": "Firebase infrastructure may process data outside your country or the European Economic Area, under standard contractual safeguards required by applicable law.",
  "@legalPrivacySection6Body": {"description": "Privacy Policy section body"},

  "legalPrivacySection7Heading": "Data Retention & Deletion",
  "@legalPrivacySection7Heading": {"description": "Privacy Policy section heading"},
  "legalPrivacySection7Body": "Profile details stored only on your device are removed when you delete the app. If you have an account, you can delete it and its associated data at any time from within the app, or by contacting us at [support email].",
  "@legalPrivacySection7Body": {"description": "Privacy Policy section body"},

  "legalPrivacySection8Heading": "Your Rights",
  "@legalPrivacySection8Heading": {"description": "Privacy Policy section heading"},
  "legalPrivacySection8Body": "Depending on where you live, you may have the right to access, correct, delete, or export your data, to object to certain processing, and to withdraw consent at any time. Contact us at [support email] to exercise these rights.",
  "@legalPrivacySection8Body": {"description": "Privacy Policy section body"},

  "legalPrivacySection9Heading": "Children",
  "@legalPrivacySection9Heading": {"description": "Privacy Policy section heading"},
  "legalPrivacySection9Body": "LeadLife is not directed at children under 16, and we do not knowingly collect information from them.",
  "@legalPrivacySection9Body": {"description": "Privacy Policy section body"},

  "legalPrivacySection10Heading": "Changes & Contact",
  "@legalPrivacySection10Heading": {"description": "Privacy Policy section heading"},
  "legalPrivacySection10Body": "We may update this policy from time to time; material changes will be reflected in the app. Questions? Reach us at [support email].",
  "@legalPrivacySection10Body": {"description": "Privacy Policy section body"},

  "legalTermsSection1Heading": "Acceptance of Terms",
  "@legalTermsSection1Heading": {"description": "Terms of Use section heading"},
  "legalTermsSection1Body": "Last updated: [fill in before release]. By using LeadLife, you agree to these Terms of Use. If you do not agree, please do not use the app.",
  "@legalTermsSection1Body": {"description": "Terms of Use section body"},

  "legalTermsSection2Heading": "The Service",
  "@legalTermsSection2Heading": {"description": "Terms of Use section heading"},
  "legalTermsSection2Body": "LeadLife is a personal-growth and self-reflection companion built around your wish, a 32-field journey, and gentle reminders. Content is provided for entertainment and self-reflection purposes only, and is not professional medical, psychological, financial, or legal advice.",
  "@legalTermsSection2Body": {"description": "Terms of Use section body"},

  "legalTermsSection3Heading": "Eligibility",
  "@legalTermsSection3Heading": {"description": "Terms of Use section heading"},
  "legalTermsSection3Body": "You must be at least 16 years old, or the age of digital consent in your country, to use LeadLife, and you agree to provide accurate information.",
  "@legalTermsSection3Body": {"description": "Terms of Use section body"},

  "legalTermsSection4Heading": "Accounts",
  "@legalTermsSection4Heading": {"description": "Terms of Use section heading"},
  "legalTermsSection4Body": "The app works anonymously by default. You may optionally link an account with Google, Apple, or email and password so your journey and purchases carry over to a new device. You are responsible for keeping your credentials secure.",
  "@legalTermsSection4Body": {"description": "Terms of Use section body"},

  "legalTermsSection5Heading": "Subscriptions & Payments",
  "@legalTermsSection5Heading": {"description": "Terms of Use section heading"},
  "legalTermsSection5Body": "Paid plans are auto-renewing subscriptions billed through the App Store or Google Play. Price and renewal terms are shown before you purchase. You can cancel any time in your App Store or Google Play account settings; cancellation takes effect at the end of the current billing period. Refunds are handled by Apple or Google according to their own policies.",
  "@legalTermsSection5Body": {"description": "Terms of Use section body"},

  "legalTermsSection6Heading": "Your Content",
  "@legalTermsSection6Heading": {"description": "Terms of Use section heading"},
  "legalTermsSection6Body": "You own what you write in the app. You grant us a limited license to store and process it solely to provide the service to you.",
  "@legalTermsSection6Body": {"description": "Terms of Use section body"},

  "legalTermsSection7Heading": "Acceptable Use",
  "@legalTermsSection7Heading": {"description": "Terms of Use section heading"},
  "legalTermsSection7Body": "You agree not to use the app unlawfully, to interfere with its operation, or to reverse-engineer, decompile, or disassemble it.",
  "@legalTermsSection7Body": {"description": "Terms of Use section body"},

  "legalTermsSection8Heading": "Disclaimer & Liability",
  "@legalTermsSection8Heading": {"description": "Terms of Use section heading"},
  "legalTermsSection8Body": "LeadLife is provided \"as is\", without warranties of any kind. To the fullest extent permitted by law, we are not liable for indirect, incidental, or consequential damages arising from your use of the app.",
  "@legalTermsSection8Body": {"description": "Terms of Use section body"},

  "legalTermsSection9Heading": "Termination",
  "@legalTermsSection9Heading": {"description": "Terms of Use section heading"},
  "legalTermsSection9Body": "We may suspend or terminate access to the app for violation of these terms. You may stop using the app, and delete your account, at any time.",
  "@legalTermsSection9Body": {"description": "Terms of Use section body"},

  "legalTermsSection10Heading": "Governing Law & Changes",
  "@legalTermsSection10Heading": {"description": "Terms of Use section heading"},
  "legalTermsSection10Body": "These terms are governed by the laws of [fill in your jurisdiction]. We may update these terms from time to time; material changes will be reflected in the app. Questions? Reach us at [support email].",
  "@legalTermsSection10Body": {"description": "Terms of Use section body"},

